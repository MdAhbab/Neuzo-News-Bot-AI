# Neuzo Backend Environment Variables
# Copy this file to backend/.env (or export in your shell) and fill in values.
# Every variable here overrides the matching entry in backend/config.yaml.

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=neuzo_db
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password_here

# News API Configuration
# Get your API key from https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# News pipeline provider: auto | newsapi | crawler
NEWS_PROVIDER=auto

# Local LLM (Ollama) used by the news crawler only
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Session Configuration
SECRET_KEY=generate_with_python_-c_"import secrets;print(secrets.token_hex(32))"
SESSION_EXPIRY_HOURS=24

# Redis Configuration (optional, for production session storage)
# REDIS_URL=redis://localhost:6379/0

# Flask Configuration
PORT=5000
# Set to true ONLY for local development (enables debugger + 0.0.0.0 binding)
FLASK_DEBUG=false

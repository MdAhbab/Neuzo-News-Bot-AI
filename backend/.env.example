# Neuzo Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_HOST=localhost
DATABASE_NAME=neuzo_db
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password_here

# News API Configuration
# Get your API key from https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Session Configuration
SECRET_KEY=your_secret_key_here_generate_with_secrets.token_hex_32
SESSION_EXPIRY_HOURS=24

# Redis Configuration (optional, for production session storage)
# REDIS_URL=redis://localhost:6379/0

# Flask Configuration
PORT=5000
FLASK_ENV=development
DEBUG=true
